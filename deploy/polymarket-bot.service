[Unit]
Description=Polymarket dry-mode trading bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/polymarket-bot
Environment=NODE_ENV=production
EnvironmentFile=/var/lib/trading-bots/polymarket-bot/.env
ExecStart=/usr/bin/node --import=tsx src/jobs/loop.ts
Restart=always
RestartSec=15
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
