# Required only when EXECUTE_REAL_TRADES=true.
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_FUNDER_ADDRESS=""
POLYMARKET_SIGNATURE_TYPE="0"
CLOB_API_KEY=""
CLOB_API_SECRET=""
CLOB_API_PASSPHRASE=""
POLYGON_RPC_URL=""
POLYMARKET_BUILDER_CODE=""

# Live calendar-arbitrage limits.
LIVE_CALENDAR_BASKET_USD="10"
LIVE_CALENDAR_MAX_COMBINED_COST="0.975"
LIVE_CALENDAR_MAX_LEG_SPREAD="0.02"
LIVE_CALENDAR_MIN_PROFIT_USD="0.10"
LIVE_MAX_TOTAL_EXPOSURE_USD="100"
LIVE_MAX_OPEN_POSITIONS="10"
LIVE_MAX_POSITION_USD="10"
LIVE_MAX_OPEN_BASKETS="5"
LIVE_MAX_DAILY_UNWIND_LOSS_USD="10"

# Optional.
POLYMARKET_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
