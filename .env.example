DATABASE_URL="file:./dev.db"
USE_LIVE_DATA="true"

# Default: observe executable calendar arbitrage without placing orders.
EXECUTE_REAL_TRADES="false"
LIVE_TRADING_PAUSED="false"

# Required only when EXECUTE_REAL_TRADES=true.
POLYMARKET_PRIVATE_KEY=""
POLYMARKET_FUNDER_ADDRESS=""
POLYMARKET_SIGNATURE_TYPE="0"
CLOB_API_KEY=""
CLOB_API_SECRET=""
CLOB_API_PASSPHRASE=""
POLYGON_RPC_URL=""
POLYMARKET_BUILDER_CODE=""

# Live calendar-arbitrage limits.
LIVE_CALENDAR_BASKET_USD="10"
LIVE_CALENDAR_MAX_COMBINED_COST="0.975"
LIVE_CALENDAR_MAX_LEG_SPREAD="0.02"
LIVE_CALENDAR_MIN_PROFIT_USD="0.10"
LIVE_BOOK_MAX_AGE_MS="2000"
LIVE_BOOK_MAX_SKEW_MS="1000"
LIVE_MAX_TOTAL_EXPOSURE_USD="100"
LIVE_MAX_OPEN_BASKETS="5"
LIVE_MAX_DAILY_UNWIND_LOSS_USD="10"

# Optional.
POLYMARKET_API_KEY=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
HERMES_API_KEY=""
