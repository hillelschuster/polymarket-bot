# Environment variables. Copy to .env.
# Paper-trading only — EXECUTE_REAL_TRADES is always false.

# --- Database ---
DATABASE_URL="file:./dev.db"

# --- Safety (never set to true in this build) ---
EXECUTE_REAL_TRADES="false"

# --- Live data (NO API KEY REQUIRED) ---
# The bot reads PUBLIC Polymarket APIs by default (leaderboard, markets,
# and any wallet's trade history). No key, no auth, no account needed.
# Set to "false" to run purely on the labeled DEMO seed data.
USE_LIVE_DATA="true"

# Optional: read-only CLOB L2 key. ONLY needed if you later want YOUR OWN
# authenticated trade history via the CLOB endpoint. NOT required for
# copy-trading research (we follow other wallets via the public Data API).
POLYMARKET_API_KEY=""

# --- Telegram (optional: alerts + end-of-day report) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Hermes (optional: LLM operator / reports) ---
HERMES_API_KEY=""
